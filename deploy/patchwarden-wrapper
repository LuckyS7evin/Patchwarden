#!/bin/bash
# ==============================================================================
# PatchWarden - wrapper des nœuds Proxmox
# ==============================================================================
# Seule commande que la clé SSH de PatchWarden peut lancer sur un nœud :
#
#   command="/usr/local/sbin/patchwarden-wrapper",from="<IP PatchWarden>",restrict ssh-ed25519 AAAA… patchwarden
#
# La commande demandée par PatchWarden arrive dans SSH_ORIGINAL_COMMAND. Elle
# doit appartenir au petit vocabulaire ci-dessous ; tout le reste est refusé
# et journalisé (journalctl -t patchwarden). Les scripts exécutés dans les
# invités sont contenus dans ce fichier : PatchWarden n'envoie que des verbes
# et des identifiants, jamais de code. Rien n'agit sur le nœud lui-même.
#
# Verbes (version 9) :
#   ping                                   version du wrapper et nom du nœud
#   lxc-detect <vmid> <0|1>                détection dans un LXC démarré (1 = apt-get update avant)
#   lxc-versions <vmid> <app>...           contenu des fichiers /root/.<app> (versions community-scripts)
#   lxc-apt <vmid> <security|full> <0|1>   mise à jour apt (1 = simulation, rien n'est modifié)
#   lxc-cs-update <vmid> <réponses> <cpu> <ram_mo>
#                                          commande `update` community-scripts, sans terminal ;
#                                          <réponses> : « - » ou y/n/_ séparés par des points
#                                          (une ligne par question, _ = Entrée) ; <cpu>/<ram_mo> :
#                                          minimum exigé par le script (0 = rien), appliqué
#                                          temporairement puis restauré, même en cas d'échec ;
#                                          update n'est lancé qu'une fois les ressources
#                                          visibles dans le CT (code 32 sinon).
#   lxc-snapshot <vmid> <nom> <garder> <seuil_pct> <0|1> <description>
#                                          snapshot avant mise à jour (1 = vérification seule) ;
#                                          refusé si le stockage ne le permet pas ou s'il est
#                                          rempli à <seuil_pct> % ou plus ; ne garde ensuite que
#                                          les <garder> plus récents snapshots PatchWarden.
#                                          <description> : base64url (UTF-8), ou « - »
#   lxc-snapdel <vmid> <nom>               suppression d'un snapshot PatchWarden
#   lxc-rollback <vmid> <nom>              retour à un snapshot PatchWarden ; le CT est
#                                          redémarré ensuite s'il tournait avant
#   lxc-restart-services <vmid>            redémarre les services systemd encore liés à des
#                                          bibliothèques remplacées (liste établie dans le CT,
#                                          jamais transmise par PatchWarden ; services système
#                                          exclus)
#   lxc-reboot <vmid>                      redémarre le CT (pct reboot)
#   lxc-docker-compose <vmid> <projet> <0|1>
#                                          met à jour un projet docker compose « classique »
#                                          (pas une stack Portainer) : pull puis up -d des
#                                          seuls services démarrés (1 = simulation). Dossier
#                                          et fichiers lus dans les labels des conteneurs, dans
#                                          l'invité : PatchWarden ne transmet que le nom du projet
#
#   vm-detect, vm-apt, vm-snapshot, vm-snapdel, vm-rollback, vm-restart-services,
#   vm-reboot, vm-docker-compose : mêmes arguments et mêmes effets pour une VM. Les scripts y sont
#   exécutés par l'agent invité QEMU (qm guest exec, script sur l'entrée
#   standard) ; les opérations longues tournent en arrière-plan dans la VM et
#   leur journal est relu toutes les 2 s.
#
# Snapshots : seuls ceux dont le nom suit pw-AAAAMMJJ-HHMM-(complet|securite|docker)
# sont acceptés. Les snapshots créés à la main ne sont jamais touchés.
#
# Codes de sortie : 0 succès, 2 requête refusée, 3 invité non démarré,
# 40 snapshot impossible sur ce stockage, 41 stockage trop rempli (ou remplissage
# inconnu), 42 snapshot déjà existant, 43 échec de pct snapshot, 44 snapshot
# introuvable, 45 échec de pct delsnapshot / rollback, 46 CT non redémarré,
# 50 échec du redémarrage d'un service, 51 systemd absent, 52 échec de pct reboot,
# 4 agent invité injoignable (VM), 5 échec d'exécution par l'agent, 22 la mise à
# jour supprimerait des paquets (refusée), 60 docker absent, 61 docker compose v2
# absent, 62 projet compose introuvable, 63 projet géré par Portainer, 64 dossier ou
# fichiers du projet introuvables, 65 configuration compose invalide, 66 échec du
# pull, 67 échec de up -d, 68 aucun service du projet démarré,
# autre : code renvoyé par la commande exécutée dans l'invité.
# ==============================================================================

set -uo pipefail
set -f
export LC_ALL=C
WRAPPER_VERSION=9
NODE="$(hostname)"
CMD="${SSH_ORIGINAL_COMMAND:-}"
TIMEOUT_DETECT=900
TIMEOUT_UPDATE=3600
# Racine de pmxcfs. Modifiable uniquement pour les tests : un client SSH ne peut
# pas transmettre cette variable (sshd n'accepte par défaut que LANG et LC_*).
PVE_DIR="${PATCHWARDEN_PVE_DIR:-/etc/pve}"
LOG_DIR="${PATCHWARDEN_LOG_DIR:-/var/log/patchwarden}"
LOCK_DIR="${PATCHWARDEN_LOCK_DIR:-/run/lock}"
# Attente maximale (s) et intervalle (s) pour que le CT voie ses ressources augmentées.
RES_WAIT="${PATCHWARDEN_RES_WAIT:-60}"
RES_POLL="${PATCHWARDEN_RES_POLL:-2}"
# VM : dossier de travail dans la VM et intervalle de relecture du journal.
VM_TMP="${PATCHWARDEN_VM_TMP:-/var/tmp}"
VM_POLL="${PATCHWARDEN_VM_POLL:-2}"
SELF="$(readlink -f "$0")"
# « --detache » : relance locale par run_detached ; jamais accessible à la clé
# SSH, dont la commande forcée ne transmet aucun argument.
DETACHED=0
[[ "${1:-}" == "--detache" ]] && DETACHED=1
VMID=""
ORIG_CORES=""
ORIG_MEM=""
BUMP=0

log() { logger -t patchwarden -- "$*" 2>/dev/null || true; }
refuse() {
	echo "PW-REFUS: $*" >&2
	log "refus : $* (commande : ${CMD:0:200})"
	exit 2
}

# Caractères autorisés : lettres, chiffres, point, tiret, soulignement, espace.
[[ "$CMD" =~ ^[A-Za-z0-9._\ -]{1,512}$ ]] || refuse "commande vide ou caractères non autorisés"
read -r -a ARGS <<<"$CMD"
VERB="${ARGS[0]:-}"
[[ -n "$VERB" ]] || refuse "commande vide"

# Type d'invité, d'après le préfixe du verbe : lxc- (pct) ou vm- (qm).
GT=lxc TOOL=pct API=lxc CONFDIR=lxc NOUN=CT
BASE="$VERB"
if [[ "$VERB" =~ ^(lxc|vm)-([a-z-]+)$ ]]; then
	BASE="${BASH_REMATCH[2]}"
	if [[ "${BASH_REMATCH[1]}" == vm ]]; then
		GT=vm TOOL=qm API=qemu CONFDIR=qemu-server NOUN=VM
	fi
elif [[ "$VERB" != ping ]]; then
	refuse "verbe inconnu : ${VERB}"
fi

guest_conf() { echo "${PVE_DIR}/nodes/${NODE}/${CONFDIR}/${VMID}.conf"; }

# Vérifie que l'invité existe sur CE nœud.
check_guest_exists() {
	VMID="$1"
	[[ "$VMID" =~ ^[1-9][0-9]{1,8}$ ]] || refuse "VMID invalide : $VMID"
	[[ -f "$(guest_conf)" ]] || refuse "${NOUN} ${VMID} absent du nœud ${NODE}"
}

# Vérifie que l'invité existe sur CE nœud et qu'il est démarré (VM : et que
# son agent répond).
check_guest() {
	local status
	check_guest_exists "$1"
	status="$("$TOOL" status "$VMID" 2>/dev/null)"
	if [[ "$status" != "status: running" ]]; then
		echo "PW-ARRETE: ${NOUN} ${VMID} non démarré (${status:-état inconnu})" >&2
		exit 3
	fi
	if [[ "$GT" == vm ]] && ! timeout 20 qm agent "$VMID" ping </dev/null >/dev/null 2>&1; then
		echo "PW-AGENT: agent invité de la VM ${VMID} injoignable (qemu-guest-agent installé et démarré dans la VM, option « QEMU Guest Agent » activée dans Proxmox ?)" >&2
		exit 4
	fi
}

# Règle pour tous les scripts d'invité : ils sont lus par « sh -s » sur l'entrée
# standard ; toute commande qui pourrait lire l'entrée standard (apt, dpkg,
# apt-listchanges, docker…) doit la recevoir de /dev/null, sinon elle
# consommerait la suite du script.
# ------------------------------------------------------------------------------
# Fonction commune aux scripts d'invité : crée dans $1 une liste de sources apt
# restreinte aux dépôts *-security (formats .list et deb822 .sources).
# Renvoie 1 si aucun dépôt de sécurité n'est configuré.
# ------------------------------------------------------------------------------
read -r -d '' SECSRC <<'SECSRC_EOF'
pw_security_sources() {
	mkdir -p "$1/parts"
	grep -hsE '^[[:space:]]*deb[[:space:]].*-security' /etc/apt/sources.list /etc/apt/sources.list.d/*.list >"$1/sources.list"
	for f in /etc/apt/sources.list.d/*.sources; do
		[ -f "$f" ] || continue
		awk 'BEGIN { RS = ""; ORS = "" }
			{ n = split($0, L, "\n"); out = ""; keep = 0; off = 0
			  for (i = 1; i <= n; i++) {
			    if (L[i] ~ /^Enabled:[ \t]*no/) off = 1
			    if (L[i] ~ /^Suites:/) { m = split(L[i], W, /[ \t]+/); s = "Suites:"
			      for (j = 2; j <= m; j++) if (W[j] ~ /-security$/) { s = s " " W[j]; keep = 1 }
			      L[i] = s }
			    out = out L[i] "\n" }
			  if (keep && !off) print out "\n" }' "$f" >"$1/parts/$(basename "$f")"
	done
	[ -s "$1/sources.list" ] || [ -n "$(cat "$1"/parts/* 2>/dev/null)" ]
}
SECSRC_EOF

# ------------------------------------------------------------------------------
# Processus encore liés à une bibliothèque remplacée par une mise à jour (fichier
# .so supprimé mais toujours en mémoire) : ils exécutent l'ancien code tant
# qu'ils ne sont pas redémarrés. Affiche « unité|commande » (unité vide hors
# service systemd). Fonction commune à la détection et à lxc-restart-services.
# ------------------------------------------------------------------------------
read -r -d '' RESTARTSCAN <<'RESTARTSCAN_EOF'
pw_stale_procs() {
	PROCDIR=/proc
	for d in "$PROCDIR"/[0-9]*; do
		[ -r "$d/maps" ] || continue
		grep -qE '\.so[.0-9]* \(deleted\)$' "$d/maps" </dev/null 2>/dev/null || continue
		unit="$(sed -n 's#.*/\([^/]*\.service\)$#\1#p' "$d/cgroup" </dev/null 2>/dev/null | head -n 1)"
		comm="$(head -c 64 "$d/comm" 2>/dev/null | tr -cd 'A-Za-z0-9._@:+-')"
		printf '%s|%s\n' "$unit" "${comm:-?}"
	done | sort -u
}
RESTARTSCAN_EOF

# Redémarrage des services trouvés par pw_stale_procs, exécuté DANS le LXC.
read -r -d '' RESTARTSVC <<'RESTARTSVC_EOF'
export LC_ALL=C
if ! command -v systemctl >/dev/null 2>&1; then
	echo "PW-ERREUR: systemd absent de ce CT : redémarrez le CT"
	exit 51
fi
units="$(pw_stale_procs | cut -d'|' -f1 | grep -E '^[A-Za-z0-9@._:-]+\.service$' | sort -u)"
rc=0
n=0
[ -n "$units" ] || echo "PW: aucun service à redémarrer"
for u in $units; do
	case "$u" in
	dbus.service | dbus-broker.service | systemd-* | user@* | getty@* | console-getty.service | container-getty@* | serial-getty@*)
		echo "PW: $u non redémarré (service système : redémarrez le CT)"
		continue
		;;
	esac
	if systemctl restart -- "$u" </dev/null; then
		echo "PW: $u redémarré"
		n=$((n + 1))
	else
		echo "PW-ERREUR: échec du redémarrage de $u"
		rc=50
	fi
done
echo "pw.restarted=$n"
pw_stale_procs | while IFS='|' read -r unit comm; do
	if [ -n "$unit" ]; then echo "PW: encore à redémarrer : $unit"; else echo "PW: encore lié aux anciennes bibliothèques : $comm (redémarrage du CT)"; fi
done
exit "$rc"
RESTARTSVC_EOF

# ------------------------------------------------------------------------------
# Script de détection exécuté DANS le LXC (POSIX sh, sortie clé=valeur).
# Lecture seule, sauf `apt-get update` si demandé (rafraîchit l'index apt).
# ------------------------------------------------------------------------------
read -r -d '' DETECT <<'DETECT_EOF'
REFRESH="${1:-0}"
export LC_ALL=C DEBIAN_FRONTEND=noninteractive
kv() { printf '%s=%s\n' "$1" "$(printf '%s' "$2" | tr -d '\r\n')"; }
has() { command -v "$1" >/dev/null 2>&1; }

kv pw.detect 1
if [ -r /etc/os-release ]; then . /etc/os-release; fi
kv os.id "${ID:-inconnu}"
kv os.version_id "${VERSION_ID:-}"
kv os.pretty "${PRETTY_NAME:-}"
kv sys.nproc "$(nproc 2>/dev/null || echo 0)"
kv sys.mem_mb "$(awk '/^MemTotal:/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)"
kv sys.root_used_pct "$(df -P / 2>/dev/null | awk 'NR==2{gsub("%","",$5); print $5}')"
if [ -e /var/run/reboot-required ]; then kv sys.reboot_required 1; else kv sys.reboot_required 0; fi
pw_stale_procs | while IFS='|' read -r unit comm; do
	if [ -n "$unit" ]; then kv restart.unit "$unit"; else kv restart.proc "$comm"; fi
done | sort -u

if [ -f /usr/bin/update ]; then
	name="$(sed -n 's/^export UPDATE_SCRIPT_NAME="\{0,1\}\([A-Za-z0-9._-]*\).*/\1/p' /usr/bin/update | head -n 1)"
	slug="$(sed -n 's/^export SCRIPT_SLUG="\{0,1\}\([A-Za-z0-9._-]*\).*/\1/p' /usr/bin/update | head -n 1)"
	base="$(sed -n 's/^export COMMUNITY_SCRIPTS_URL="\{0,1\}\([^"]*\).*/\1/p' /usr/bin/update | head -n 1)"
	if [ -n "$name" ]; then
		entry=helper
	else
		url="$(grep -o 'https\{0,1\}://[^"]*/ct/[A-Za-z0-9._-]*\.sh' /usr/bin/update | head -n 1)"
		if [ -n "$url" ]; then
			entry=legacy
			name="$(basename "$url" .sh)"
			base="${url%/ct/*}"
		else
			entry=inconnu
		fi
	fi
	kv cs.entry "$entry"
	kv cs.script "$name"
	kv cs.slug "${slug:-$name}"
	kv cs.base "$base"
else
	kv cs.entry aucune
fi

if has apt-get; then
	kv apt.present 1
	if [ "$REFRESH" = 1 ]; then
		apt-get update -q </dev/null >/tmp/.pw-apt-update.log 2>&1
		rc=$?
		kv apt.refresh_rc "$rc"
		if [ "$rc" != 0 ]; then
			grep -E '^(E|W):' /tmp/.pw-apt-update.log | tail -n 3 | while IFS= read -r l; do kv apt.refresh_err "$l"; done
		fi
		rm -f /tmp/.pw-apt-update.log
	fi
	newest="$(find /var/lib/apt/lists -maxdepth 1 -type f -name '*Release' -printf '%T@\n' 2>/dev/null | sort -n | tail -n 1)"
	if [ -n "$newest" ]; then kv apt.index_age_h "$(( ($(date +%s) - ${newest%.*}) / 3600 ))"; fi

	# Une ligne par paquet : nom, version installée (- si nouveau), nouvelle version, 1 si sécurité.
	# Même commande que la mise à jour réelle (lxc-apt) : jamais de suppression.
	apt-get -s -o Debug::NoLocking=1 --with-new-pkgs upgrade </dev/null 2>/dev/null | awk '
		/^Inst / {
			name = $2; old = "-"
			if ($3 ~ /^\[/) { old = $3; gsub(/\[|\]/, "", old) }
			p = index($0, "("); inner = substr($0, p + 1)
			q = index(inner, ")"); if (q > 0) inner = substr(inner, 1, q - 1)
			split(inner, a, " ")
			sec = (inner ~ /-security|Security:/) ? 1 : 0
			n++; s += sec
			print "apt.pkg=" name " " old " " a[1] " " sec
		}
		END { print "apt.total=" n + 0; print "apt.security=" s + 0 }'
	kv apt.upgrade_simple "$(apt-get -s -o Debug::NoLocking=1 upgrade </dev/null 2>/dev/null | grep -c '^Inst ')"
	# Paquets que seul un dist-upgrade installerait (il peut supprimer des paquets) : non appliqués.
	dist="$(apt-get -s -o Debug::NoLocking=1 dist-upgrade </dev/null 2>/dev/null)"
	kv apt.dist_total "$(printf '%s\n' "$dist" | grep -c '^Inst ')"
	kv apt.dist_remove "$(printf '%s\n' "$dist" | grep -c '^Remv ')"

	# Simulation « sécurité seule » stricte : uniquement les dépôts *-security.
	tmp="$(mktemp -d /tmp/.pw-detect.XXXXXX)"
	if pw_security_sources "$tmp"; then
		kv apt.security_repo 1
		apt-get -s -o Debug::NoLocking=1 -o Dir::Etc::SourceList="$tmp/sources.list" \
			-o Dir::Etc::SourceParts="$tmp/parts" --with-new-pkgs upgrade </dev/null 2>/dev/null |
			awk '/^Inst / { n++; print "apt.strict_pkg=" $2 } END { print "apt.security_strict=" n + 0 }'
	else
		kv apt.security_repo 0
	fi
	rm -rf "$tmp"
else
	kv apt.present 0
fi

# Produits particuliers : hôte Proxmox VE (jamais mis à jour), PBS, OpenMediaVault.
if has dpkg-query; then
	pv() { dpkg-query -W -f='${Status} ${Version}\n' "$1" 2>/dev/null </dev/null | awk '$3 == "installed" { print $4 }'; }
	for p in pve-manager:pve proxmox-backup-server:pbs openmediavault:omv; do
		v="$(pv "${p%%:*}")"
		if [ -n "$v" ]; then
			kv special.kind "${p##*:}"
			kv special.version "$v"
			break
		fi
	done
fi

if has docker && docker info </dev/null >/dev/null 2>&1; then
	kv docker.present 1
	kv docker.containers "$(docker ps -aq </dev/null 2>/dev/null | wc -l)"
	kv docker.compose "$(docker compose version --short </dev/null 2>/dev/null | head -n 1)"
	# Un conteneur par ligne : id|nom|image|id d'image|état|projet|service|dossier|fichiers|version|source.
	ids="$(docker ps -aq --no-trunc </dev/null 2>/dev/null | head -n 200)"
	if [ -n "$ids" ]; then
		# shellcheck disable=SC2086
		docker inspect --format 'docker.ctr={{.Id}}|{{.Name}}|{{.Config.Image}}|{{.Image}}|{{.State.Status}}|{{index .Config.Labels "com.docker.compose.project"}}|{{index .Config.Labels "com.docker.compose.service"}}|{{index .Config.Labels "com.docker.compose.project.working_dir"}}|{{index .Config.Labels "com.docker.compose.project.config_files"}}|{{index .Config.Labels "org.opencontainers.image.version"}}|{{index .Config.Labels "org.opencontainers.image.source"}}' $ids </dev/null 2>/dev/null | tr -d '\r'
		# Empreintes (digests) des images, telles que téléchargées du registre.
		# shellcheck disable=SC2086
		imgs="$(docker inspect --format '{{.Image}}' $ids </dev/null 2>/dev/null | sort -u)"
		# shellcheck disable=SC2086
		[ -n "$imgs" ] && docker image inspect --format 'docker.img={{.Id}}|{{join .RepoDigests ","}}' $imgs </dev/null 2>/dev/null | tr -d '\r'
	fi
else
	kv docker.present 0
fi
kv pw.end 1
DETECT_EOF

# Lecture des fichiers de version community-scripts (/root/.<app>).
read -r -d '' VERSIONS <<'VERSIONS_EOF'
for n in "$@"; do
	f="/root/.$n"
	if [ -f "$f" ]; then
		printf 'version.%s=%s\n' "$n" "$(head -n 1 "$f" | tr -d '\r' | cut -c1-120 | tr -cd '[:print:]')"
	else
		printf 'version_absent.%s=1\n' "$n"
	fi
done
VERSIONS_EOF

# ------------------------------------------------------------------------------
# Mise à jour apt DANS le LXC. $1 = security|full, $2 = 1 pour simuler.
# Jamais de suppression de paquet (--with-new-pkgs upgrade) ; en cas de conflit
# de fichier de configuration, la version locale est gardée (confold).
# ------------------------------------------------------------------------------
read -r -d '' APTRUN <<'APTRUN_EOF'
MODE="$1"; DRY="$2"
export LC_ALL=C DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1 APT_LISTCHANGES_FRONTEND=none
OPTS="-o APT::Color=0 -o Dpkg::Use-Pty=0 -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold"
if [ "$DRY" = 1 ]; then
	echo "PW: simulation (apt-get -s) : rien ne sera modifié ; index apt de la dernière détection"
	OPTS="$OPTS -s -o Debug::NoLocking=1"
else
	echo "PW: apt-get update"
	apt-get update -o APT::Color=0 -o DPkg::Lock::Timeout=300 </dev/null || echo "PW-AVERTISSEMENT: apt-get update a signalé des erreurs, la mise à jour continue avec l'index disponible"
fi
tmp=""
if [ "$MODE" = security ]; then
	tmp="$(mktemp -d /tmp/.pw-apt.XXXXXX)"
	if ! pw_security_sources "$tmp"; then
		rm -rf "$tmp"
		echo "PW-ERREUR: aucun dépôt de sécurité configuré dans cet invité"
		exit 21
	fi
	echo "PW: dépôts utilisés (sécurité uniquement) :"
	cat "$tmp/sources.list" "$tmp"/parts/* 2>/dev/null | grep -E '^(deb |URIs:|Suites:)' | sed 's/^/PW:   /'
	OPTS="$OPTS -o Dir::Etc::SourceList=$tmp/sources.list -o Dir::Etc::SourceParts=$tmp/parts"
fi
case "$MODE" in
dist | omv)
	# Méthode recommandée pour PBS (dist-upgrade) et OpenMediaVault
	# (omv-upgrade) ; jamais de suppression de paquet.
	nrm="$(apt-get -s -o Debug::NoLocking=1 dist-upgrade </dev/null 2>/dev/null | grep -c '^Remv ')"
	if [ "$nrm" != 0 ]; then
		echo "PW-ERREUR: la mise à jour supprimerait ${nrm} paquet(s) : à faire à la main"
		exit 22
	fi
	if [ "$MODE" = omv ] && [ "$DRY" != 1 ] && command -v omv-upgrade >/dev/null 2>&1; then
		echo "PW: omv-upgrade (méthode OpenMediaVault : dist-upgrade puis déploiement de la configuration)"
		omv-upgrade </dev/null
		rc=$?
	else
		echo "PW: apt-get dist-upgrade"
		# shellcheck disable=SC2086
		apt-get $OPTS -y dist-upgrade </dev/null
		rc=$?
	fi
	;;
*)
	echo "PW: apt-get --with-new-pkgs upgrade"
	# shellcheck disable=SC2086
	apt-get $OPTS -y --with-new-pkgs upgrade </dev/null
	rc=$?
	;;
esac
[ -n "$tmp" ] && rm -rf "$tmp"
if [ "$DRY" != 1 ] && [ "$rc" = 0 ]; then
	apt-get -o APT::Color=0 -y autoclean </dev/null >/dev/null 2>&1
fi
if [ -e /var/run/reboot-required ]; then echo "pw.reboot_required=1"; fi
echo "pw.apt_rc=$rc"
exit "$rc"
APTRUN_EOF

# ------------------------------------------------------------------------------
# Commande `update` community-scripts DANS le LXC, sans terminal. $1 = réponses.
# Le journal détaillé du moteur (/tmp/create-lxc-*.log, nom aléatoire) est
# repéré puis suivi en direct ; la sortie standard de `update` (bannière,
# erreurs précoces) est affichée à la fin.
# ------------------------------------------------------------------------------
read -r -d '' SEEN <<'SEEN_EOF'
# Ressources vues depuis le CT, mesurées comme le fait le script community-scripts.
echo "pw.seen=$(nproc 2>/dev/null || echo 0) $(awk '/^MemTotal:/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 0)" </dev/null
SEEN_EOF

read -r -d '' CSUPDATE <<'CSUPDATE_EOF'
ANS="$1"
if [ ! -x /usr/bin/update ]; then echo "PW-ERREUR: /usr/bin/update absent"; exit 30; fi
marker="$(mktemp /tmp/.pw-marker.XXXXXX)"
out="$(mktemp /tmp/.pw-update-out.XXXXXX)"
inp="$(mktemp /tmp/.pw-update-in.XXXXXX)"
if [ "$ANS" = "-" ]; then : >"$inp"; else printf '%s\n' "$ANS" | tr '.' '\n' | sed 's/^_$//' >"$inp"; fi
sleep 1
echo "PW: lancement de update (PHS_SILENT=1)"
( PHS_SILENT=1 TERM=dumb update <"$inp" >"$out" 2>&1; echo $? >"$out.rc" ) &
pid=$!
log=""
i=0
while [ -z "$log" ] && kill -0 "$pid" 2>/dev/null && [ "$i" -lt 180 ]; do
	log="$(find /tmp -maxdepth 1 -name 'create-lxc-*.log' -newer "$marker" 2>/dev/null | head -n 1)"
	[ -z "$log" ] && sleep 1
	i=$((i + 1))
done
[ -z "$log" ] && log="$(find /tmp -maxdepth 1 -name 'create-lxc-*.log' -newer "$marker" 2>/dev/null | head -n 1)"
if [ -n "$log" ]; then
	echo "PW: journal détaillé : $log"
	if tail --pid="$$" -n 0 /dev/null 2>/dev/null; then
		tail -n +1 -f --pid="$pid" "$log"
	else
		wait "$pid"
		cat "$log"
	fi
fi
wait "$pid" 2>/dev/null
echo "PW: ----- sortie standard de update -----"
cat "$out"
rc="$(cat "$out.rc" 2>/dev/null || echo 1)"
[ -n "$log" ] && rm -f "$log"
rm -f "$marker" "$out" "$out.rc" "$inp"
if [ -e /var/run/reboot-required ]; then echo "pw.reboot_required=1"; fi
echo "pw.update_rc=$rc"
exit "$rc"
CSUPDATE_EOF

# ------------------------------------------------------------------------------
# Mise à jour d'un projet docker compose DANS l'invité. $1 = projet, $2 = 1 pour
# simuler. Le dossier et les fichiers du projet sont lus dans les labels posés
# par docker compose sur ses conteneurs. Seuls les services démarrés sont
# concernés : un service arrêté volontairement n'est jamais relancé. Les stacks
# Portainer (dossier /data/compose/<id>) sont refusées : elles passent par l'API
# Portainer, sinon Portainer perdrait la trace de leur configuration.
# ------------------------------------------------------------------------------
read -r -d '' COMPOSEUP <<'COMPOSEUP_EOF'
P="$1"; DRY="$2"
export LC_ALL=C
set -f
if ! command -v docker >/dev/null 2>&1; then echo "PW-ERREUR: docker absent de cet invité"; exit 60; fi
if ! docker compose version </dev/null >/dev/null 2>&1; then echo "PW-ERREUR: docker compose v2 (commande « docker compose ») absent de cet invité"; exit 61; fi
cid="$(docker ps -aq --filter "label=com.docker.compose.project=$P" </dev/null 2>/dev/null | head -n 1)"
if [ -z "$cid" ]; then echo "PW-ERREUR: aucun conteneur du projet compose « $P »"; exit 62; fi
lbl() { docker inspect --format "{{index .Config.Labels \"$1\"}}" "$cid" </dev/null 2>/dev/null | tr -d '\r'; }
wd="$(lbl com.docker.compose.project.working_dir)"
files="$(lbl com.docker.compose.project.config_files)"
envs="$(lbl com.docker.compose.project.environment_file)"
case "$wd" in
/data/compose/*) echo "PW-ERREUR: projet géré par Portainer (stack) : mise à jour par l'API Portainer uniquement"; exit 63 ;;
/*) ;;
*) echo "PW-ERREUR: dossier du projet inconnu (label working_dir absent)"; exit 64 ;;
esac
if [ ! -d "$wd" ]; then echo "PW-ERREUR: dossier du projet introuvable : $wd"; exit 64; fi
if [ -z "$files" ]; then echo "PW-ERREUR: fichiers compose inconnus (label config_files absent)"; exit 64; fi
set --
oldifs="$IFS"
IFS=','
for f in $files; do
	case "$f" in /*) ;; *) f="$wd/$f" ;; esac
	if [ ! -f "$f" ]; then IFS="$oldifs"; echo "PW-ERREUR: fichier compose introuvable : $f"; exit 64; fi
	set -- "$@" -f "$f"
done
for f in $envs; do
	[ -f "$f" ] && set -- "$@" --env-file "$f"
done
IFS="$oldifs"
cd "$wd" || exit 64
echo "PW: projet $P, dossier $wd"
echo "PW: fichiers : $files"
if ! docker compose -p "$P" "$@" config -q </dev/null; then echo "PW-ERREUR: configuration compose invalide"; exit 65; fi
svcs="$(docker compose -p "$P" "$@" ps --services --status running </dev/null 2>/dev/null | tr '\n' ' ')"
stopped="$(docker compose -p "$P" "$@" ps --services --status exited </dev/null 2>/dev/null | tr '\n' ' ')"
if [ -z "$(printf '%s' "$svcs" | tr -d ' ')" ]; then echo "PW-ERREUR: aucun service du projet n'est démarré : rien n'est mis à jour (ni relancé)"; exit 68; fi
echo "PW: services démarrés, mis à jour : $svcs"
[ -n "$(printf '%s' "$stopped" | tr -d ' ')" ] && echo "PW: services arrêtés, laissés tels quels : $stopped"
echo "PW: images :"
docker compose -p "$P" "$@" config --images </dev/null 2>/dev/null | sed 's/^/PW:   /'
if [ "$DRY" = 1 ]; then
	echo "PW: simulation : docker compose pull et up -d ne sont pas lancés"
	exit 0
fi
echo "PW: docker compose pull"
# shellcheck disable=SC2086
if ! docker compose -p "$P" "$@" pull $svcs </dev/null 2>&1; then echo "PW-ERREUR: échec du téléchargement des images"; exit 66; fi
echo "PW: docker compose up -d (seuls les conteneurs dont l'image a changé sont recréés)"
# shellcheck disable=SC2086
if ! docker compose -p "$P" "$@" up -d --no-deps $svcs </dev/null 2>&1; then echo "PW-ERREUR: échec de docker compose up -d"; exit 67; fi
docker compose -p "$P" "$@" ps </dev/null 2>&1 | sed 's/^/PW:   /'
exit 0
COMPOSEUP_EOF

# ------------------------------------------------------------------------------
# Exécution d'un script dans l'invité (script sur l'entrée standard).
#   g_sh <délai> [args]     : sortie rendue à la fin (VM) ou au fil de l'eau (CT)
#   g_stream <délai> [args] : sortie au fil de l'eau dans les deux cas
# ------------------------------------------------------------------------------
# Réponse de qm guest exec : JSON dont la sortie est encodée deux fois (octets
# de la VM lus en latin-1) ; chaque caractère est réécrit tel quel en octet.
read -r -d '' VMDECODE <<'VMDECODE_EOF'
no warnings;
local $/;
my $d = eval { JSON::PP->new->utf8->decode(<STDIN> // "") };
if (ref $d ne "HASH") { print STDERR "PW-AGENT: réponse illisible de qm guest exec (agent invité injoignable ?)\n"; exit 4 }
if (!$d->{exited}) { print STDERR "PW-ERREUR: délai dépassé dans la VM\n"; exit 124 }
binmode STDOUT; binmode STDERR;
print STDOUT $d->{"out-data"} if defined $d->{"out-data"};
print STDERR $d->{"err-data"} if defined $d->{"err-data"};
exit($d->{exitcode} // 1);
VMDECODE_EOF

# Lancement en arrière-plan dans la VM : $1 = préfixe des fichiers (.sh, .log, .rc).
read -r -d '' VM_LAUNCH <<'VM_LAUNCH_EOF'
f="$1"; shift
S=""; command -v setsid >/dev/null 2>&1 && S=setsid
$S sh -c 'sh "$0.sh" "$@" > "$0.log" 2>&1 < /dev/null; echo $? > "$0.rc"' "$f" "$@" > /dev/null 2>&1 < /dev/null &
VM_LAUNCH_EOF

# vm_cmd <délai> <commande>... : qm guest exec (entrée standard transmise).
vm_cmd() {
	local t="$1"
	shift
	timeout $((t + 30)) qm guest exec "$VMID" --pass-stdin 1 --timeout "$t" -- "$@" | perl -MJSON::PP -e "$VMDECODE"
	return "${PIPESTATUS[1]}"
}

# vm_stream : dépose le script dans la VM, le lance en arrière-plan, puis relit
# son journal par décalage jusqu'au code de sortie.
vm_stream() {
	local t="$1" f off=0 n rc="" start=$SECONDS chunk errf
	shift
	f="${VM_TMP}/patchwarden-$(date +%s)-$$"
	chunk="$(mktemp)" errf="$(mktemp)"
	if ! vm_cmd 60 sh -c 'umask 077; cat > "$1.sh"' sh "$f"; then
		echo "PW-ERREUR: dépôt du script dans la VM impossible"
		rm -f "$chunk" "$errf"
		return 5
	fi
	if ! vm_cmd 30 sh -c "$VM_LAUNCH" sh "$f" "$@" </dev/null; then
		echo "PW-ERREUR: lancement du script dans la VM impossible"
		rm -f "$chunk" "$errf"
		return 5
	fi
	while :; do
		sleep "$VM_POLL"
		vm_cmd 60 sh -c 'tail -c +"$2" "$1.log" 2>/dev/null; if [ -f "$1.rc" ]; then cat "$1.rc" >&2; fi' sh "$f" "$((off + 1))" </dev/null >"$chunk" 2>"$errf"
		n="$(stat -c %s "$chunk")"
		cat "$chunk"
		off=$((off + n))
		if [[ -n "$rc" ]]; then
			break
		fi
		rc="$(grep -E '^[0-9]+$' "$errf" | tail -n 1)"
		[[ -n "$rc" ]] && continue # une dernière lecture pour la fin du journal
		if ((SECONDS - start > t)); then
			echo "PW-ERREUR: délai de ${t} s dépassé ; l'opération continue peut-être dans la VM (journal : ${f}.log)"
			rm -f "$chunk" "$errf"
			return 124
		fi
	done
	vm_cmd 30 rm -f "$f.sh" "$f.log" "$f.rc" </dev/null >/dev/null 2>&1
	rm -f "$chunk" "$errf"
	return "$rc"
}

g_sh() {
	local t="$1"
	shift
	if [[ "$GT" == vm ]]; then
		vm_cmd "$t" sh -s -- "$@"
	else
		timeout "$t" pct exec "$VMID" -- sh -s -- "$@"
	fi
}

g_stream() {
	local t="$1"
	shift
	if [[ "$GT" == vm ]]; then
		vm_stream "$t" "$@"
	else
		timeout "$t" pct exec "$VMID" -- sh -s -- "$@"
	fi
}

# ------------------------------------------------------------------------------
# Exécution détachée des mises à jour réelles. La partie visible (connexion SSH)
# ne fait que suivre le journal ; le travail tourne dans une nouvelle session,
# sous verrou par CT : si la connexion est perdue, la mise à jour se termine
# quand même (et les ressources sont restaurées). Journal gardé 30 jours dans
# LOG_DIR. Code 99 : une opération PatchWarden est déjà en cours sur ce CT.
# ------------------------------------------------------------------------------
run_detached() {
	local label="$1" fn="$2" logf bg rc
	if [[ "$DETACHED" == 1 ]]; then
		"$fn"
		exit $?
	fi
	mkdir -p "$LOG_DIR" && chmod 700 "$LOG_DIR"
	find "$LOG_DIR" -maxdepth 1 -type f -name '*.log' -mtime +30 -delete 2>/dev/null
	logf="${LOG_DIR}/${VMID}-$(date +%Y%m%d-%H%M%S)-${label}.log"
	: >"$logf"
	echo "pw.node_log=${logf}"
	setsid -w flock -n -E 99 "${LOCK_DIR}/patchwarden-${VMID}.lock" "$SELF" --detache </dev/null >>"$logf" 2>&1 &
	bg=$!
	tail -n +1 -f --pid="$bg" "$logf"
	wait "$bg"
	rc=$?
	if [[ "$rc" == 99 ]]; then
		echo "PW-REFUS: une opération PatchWarden est déjà en cours sur l'invité ${VMID}" >&2
	fi
	exit "$rc"
}

run_apt() {
	log "${VERB} ${VMID} ${ARGS[2]} simulation=${ARGS[3]}"
	if [[ "${ARGS[3]}" == 1 ]]; then
		g_sh 900 "${ARGS[2]}" "${ARGS[3]}" <<<"${SECSRC}
${APTRUN}"
	else
		g_stream "$TIMEOUT_UPDATE" "${ARGS[2]}" "${ARGS[3]}" <<<"${SECSRC}
${APTRUN}"
	fi
}

run_cs_update() {
	local conf="${PVE_DIR}/nodes/${NODE}/lxc/${VMID}.conf"
	ORIG_CORES="$(sed -n '/^\[/q;s/^cores: *//p' "$conf")"
	ORIG_MEM="$(sed -n '/^\[/q;s/^memory: *//p' "$conf")"
	local new_cores="$ORIG_CORES" new_mem="${ORIG_MEM:-512}"
	BUMP=0
	# cores absent = tous les cœurs de l'hôte : rien à augmenter.
	if [[ -n "$ORIG_CORES" && "${ARGS[3]}" -gt "$ORIG_CORES" ]]; then new_cores="${ARGS[3]}"; BUMP=1; fi
	if [[ "${ARGS[4]}" -gt "${ORIG_MEM:-512}" ]]; then new_mem="${ARGS[4]}"; BUMP=1; fi
	if [[ "$BUMP" == 1 ]]; then
		trap restore_resources EXIT HUP INT TERM PIPE
		echo "PW: ressources portées temporairement à ${new_cores:-tous les} CPU / ${new_mem} Mo (d'origine : ${ORIG_CORES:-tous les} CPU / ${ORIG_MEM:-512} Mo)"
		local args=(--memory "$new_mem")
		[[ "$new_cores" != "$ORIG_CORES" ]] && args+=(--cores "$new_cores")
		pct set "$VMID" "${args[@]}" || { echo "PW-ERREUR: augmentation des ressources impossible"; exit 31; }
		log "lxc-cs-update ${VMID} : ressources portées à ${new_cores:-tous les} CPU / ${new_mem} Mo"
		wait_resources "$new_cores" "$new_mem" || exit 32
	fi
	log "lxc-cs-update ${VMID} réponses=${ARGS[2]} cpu=${ARGS[3]} ram=${ARGS[4]}"
	timeout "$TIMEOUT_UPDATE" pct exec "$VMID" -- sh -s -- "${ARGS[2]}" <<<"$CSUPDATE"
}

# pct set écrit la configuration tout de suite, mais le nombre de CPU d'un CT
# démarré n'est appliqué (cpuset) qu'au passage suivant de pvestatd, toutes les
# 10 s. Le script community-scripts mesure nproc dès son lancement et refuse
# (code 113) s'il voit encore l'ancienne valeur : attendre que le CT voie les
# nouvelles ressources. $1 : CPU attendus (vide = tous les cœurs), $2 : Mo.
wait_resources() {
	local cpu="$1" mem="$2" start=$SECONDS c m
	while :; do
		read -r c m < <(timeout 30 pct exec "$VMID" -- sh -s <<<"$SEEN" 2>/dev/null | sed -n 's/^pw\.seen=//p')
		[[ "${c:-}" =~ ^[0-9]+$ ]] || c=0
		[[ "${m:-}" =~ ^[0-9]+$ ]] || m=0
		if { [[ -z "$cpu" ]] || ((c >= cpu)); } && ((m >= mem)); then
			echo "PW: ressources vues dans le CT : ${c} CPU / ${m} Mo (après $((SECONDS - start)) s)"
			return 0
		fi
		if ((SECONDS - start >= RES_WAIT)); then
			echo "PW-ERREUR: après ${RES_WAIT} s, le CT ne voit que ${c} CPU / ${m} Mo (attendu : ${cpu:-tous les} CPU / ${mem} Mo). Le nombre de CPU d'un CT démarré est appliqué par pvestatd : vérifiez « systemctl status pvestatd » sur ${NODE}"
			log "lxc-cs-update ${VMID} : ressources non visibles dans le CT après ${RES_WAIT} s"
			return 1
		fi
		sleep "$RES_POLL"
	done
}

# Même délai à la restauration : la détection qui suit verrait encore les CPU
# augmentés. Non bloquant.
wait_cpu_restored() {
	local cpu="$1" start=$SECONDS c
	while :; do
		read -r c _ < <(timeout 30 pct exec "$VMID" -- sh -s <<<"$SEEN" 2>/dev/null | sed -n 's/^pw\.seen=//p')
		if [[ "${c:-}" =~ ^[0-9]+$ ]] && ((c <= cpu)); then
			echo "PW: le CT voit de nouveau ${c} CPU"
			return 0
		fi
		if ((SECONDS - start >= RES_WAIT)); then
			echo "PW: le CT verra ses ${cpu} CPU d'origine au prochain passage de pvestatd"
			return 0
		fi
		sleep "$RES_POLL"
	done
}

restore_resources() {
	local rc=$?
	trap - EXIT HUP INT TERM PIPE
	local args=()
	[[ -n "$ORIG_CORES" ]] && args+=(--cores "$ORIG_CORES")
	if [[ -n "$ORIG_MEM" ]]; then args+=(--memory "$ORIG_MEM"); else args+=(--delete memory); fi
	if pct set "$VMID" "${args[@]}"; then
		echo "PW: ressources restaurées : ${ORIG_CORES:-tous les} CPU / ${ORIG_MEM:-512} Mo"
		log "lxc-cs-update ${VMID} : ressources restaurées"
		[[ -n "$ORIG_CORES" ]] && wait_cpu_restored "$ORIG_CORES"
	else
		echo "PW-ALERTE: impossible de restaurer les ressources du CT ${VMID} (${ORIG_CORES:-?} CPU / ${ORIG_MEM:-512} Mo) : à corriger à la main"
		log "ALERTE : ressources du CT ${VMID} non restaurées"
	fi
	exit "$rc"
}

# ------------------------------------------------------------------------------
# Snapshots (côté nœud). Seuls les snapshots nommés par PatchWarden sont gérés.
# ------------------------------------------------------------------------------
PW_SNAP_RE='^pw-[0-9]{8}-[0-9]{4}-(complet|securite|docker)$'
SNAP=""
KEEP=1
MAXPCT=90
DESC64="-"

# snap_info décrit les snapshots du CT $VMID (lignes snap.*) : possibilité
# (API Proxmox, mêmes règles que l'interface), stockages et remplissage,
# snapshots PatchWarden (nom, date, description), nombre des autres snapshots.
snap_info() {
	local conf feat vol st line binds=0 vols
	conf="$(guest_conf)"
	local -A seen=()
	echo "snap.info=1"
	feat="$(pvesh get "/nodes/${NODE}/${API}/${VMID}/feature" --feature snapshot --output-format json 2>/dev/null)"
	if [[ "$GT" == vm ]]; then
		vols="$(sed -n '/^\[/q;/media=cdrom/d;s/^\(scsi[0-9]\+\|virtio[0-9]\+\|sata[0-9]\+\|ide[0-9]\+\|efidisk0\|tpmstate0\): *\([^,]*\).*/\2/p' "$conf")"
	else
		vols="$(sed -n '/^\[/q;s/^\(rootfs\|mp[0-9]\+\): *\([^,]*\).*/\2/p' "$conf")"
	fi
	if [[ "$feat" =~ \"hasFeature\":[[:space:]]*(1|true) ]]; then echo "snap.possible=1"; else echo "snap.possible=0"; fi
	while IFS= read -r vol; do
		if [[ "$vol" == /* ]]; then
			binds=$((binds + 1))
			continue
		fi
		st="${vol%%:*}"
		[[ -n "$st" && -z "${seen[$st]:-}" ]] || continue
		seen[$st]=1
		line="$(pvesm status --storage "$st" 2>/dev/null | awk 'NR==2{gsub("%","",$7); print $2, $7}')"
		echo "snap.storage=${st} ${line:-? -1}"
	done <<<"$vols"
	echo "snap.bind=${binds}"
	pvesh get "/nodes/${NODE}/${API}/${VMID}/snapshot" --output-format json 2>/dev/null | perl -MJSON::PP -e '
		binmode STDOUT, ":encoding(UTF-8)";
		local $/;
		my $d = eval { JSON::PP->new->utf8->decode(<STDIN>) };
		$d = [] unless ref $d eq "ARRAY";
		my $other = 0;
		for my $s (sort { ($a->{snaptime} // 0) <=> ($b->{snaptime} // 0) } @$d) {
			next if !defined $s->{name} || $s->{name} eq "current";
			if ($s->{name} =~ /^pw-[0-9]{8}-[0-9]{4}-(complet|securite|docker)$/) {
				my $desc = $s->{description} // "";
				$desc =~ s/[\x00-\x1f]+/ /g;
				printf "snap.pw=%s %d %s\n", $s->{name}, $s->{snaptime} // 0, $desc;
			} else {
				$other++;
			}
		}
		print "snap.other=$other\n";'
}

snap_exists() { snap_info | grep -q "^snap\.pw=${SNAP} "; }

# snap_check : le snapshot $SNAP peut-il être pris ? (aucune modification)
snap_check() {
	local info st typ pct ok=1
	info="$(snap_info)"
	if ! grep -qx 'snap.possible=1' <<<"$info"; then
		echo "PW-ERREUR: snapshot impossible : le stockage de cette ${NOUN} ne le permet pas (ou disque physique en passthrough) ($(sed -n 's/^snap\.storage=\([^ ]*\) \([^ ]*\).*/\1 : \2/p' <<<"$info" | paste -sd, -)). Stockages compatibles : LVM-thin, ZFS, Ceph RBD, Btrfs"
		return 40
	fi
	while read -r st typ pct; do
		if ! [[ "$pct" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
			echo "PW-ERREUR: remplissage du stockage ${st} inconnu (pvesm status) : snapshot refusé"
			return 41
		fi
		if awk -v p="$pct" -v m="$MAXPCT" 'BEGIN{exit !(p >= m)}'; then
			echo "PW-ERREUR: stockage ${st} (${typ}) rempli à ${pct} % (seuil : ${MAXPCT} %) : snapshot refusé"
			return 41
		fi
		echo "PW: stockage ${st} (${typ}) rempli à ${pct} % (seuil : ${MAXPCT} %)"
		ok=0
	done < <(sed -n 's/^snap\.storage=//p' <<<"$info")
	if [[ "$ok" == 1 ]]; then
		echo "PW-ERREUR: aucun stockage trouvé pour cet invité : snapshot refusé"
		return 41
	fi
	if grep -q "^snap\.pw=${SNAP} " <<<"$info"; then
		echo "PW-ERREUR: le snapshot ${SNAP} existe déjà"
		return 42
	fi
	if grep -q '^snap\.bind=[1-9]' <<<"$info"; then
		echo "PW: attention : les volumes hors stockage Proxmox (montages liés, disques en passthrough) ne font pas partie du snapshot"
	fi
	echo "PW: snapshot ${SNAP} possible"
	return 0
}

desc_decode() {
	local s="$1"
	[[ "$s" == - ]] && return 0
	s="${s//-/+}"
	s="${s//_//}"
	while ((${#s} % 4)); do s+="="; done
	base64 -d <<<"$s" 2>/dev/null | tr -d '\000-\037' | head -c 400
}

run_snapshot() {
	local desc old rc
	snap_check
	rc=$?
	((rc == 0)) || exit "$rc"
	desc="$(desc_decode "$DESC64")"
	[[ -n "$desc" ]] || desc="PatchWarden"
	log "${VERB} ${VMID} ${SNAP}"
	echo "PW: création du snapshot ${SNAP}"
	# Les commandes pct décodent leurs arguments selon la locale
	# (PVE::JSONSchema, decode('locale')) : en LC_ALL=C, chaque octet accentué
	# de la description deviendrait « � ».
	if ! LC_ALL=C.UTF-8 "$TOOL" snapshot "$VMID" "$SNAP" --description "$desc" </dev/null; then
		echo "PW-ERREUR: ${TOOL} snapshot a échoué : mise à jour annulée"
		exit 43
	fi
	echo "PW: snapshot ${SNAP} créé"
	# Rétention : les KEEP plus récents snapshots PatchWarden, le nouveau compris
	# (le nom commence par la date : l'ordre alphabétique est l'ordre chronologique).
	while IFS= read -r old; do
		[[ "$old" =~ $PW_SNAP_RE && "$old" != "$SNAP" ]] || continue
		if "$TOOL" delsnapshot "$VMID" "$old" </dev/null; then
			echo "PW: ancien snapshot ${old} supprimé (rétention : ${KEEP})"
			log "${VERB} ${VMID} : ${old} supprimé (rétention)"
		else
			echo "PW-ALERTE: suppression de l'ancien snapshot ${old} impossible"
		fi
	done < <(snap_info | sed -n 's/^snap\.pw=\([^ ]*\) .*/\1/p' | sort -r | tail -n +$((KEEP + 1)))
	snap_info
}

run_snapdel() {
	if ! snap_exists; then
		echo "PW-ERREUR: snapshot ${SNAP} introuvable sur l'invité ${VMID}"
		exit 44
	fi
	log "${VERB} ${VMID} ${SNAP}"
	if ! "$TOOL" delsnapshot "$VMID" "$SNAP" </dev/null; then
		echo "PW-ERREUR: ${TOOL} delsnapshot a échoué"
		exit 45
	fi
	echo "PW: snapshot ${SNAP} supprimé"
	snap_info
}

run_rollback() {
	local before after
	if ! snap_exists; then
		echo "PW-ERREUR: snapshot ${SNAP} introuvable sur l'invité ${VMID}"
		exit 44
	fi
	before="$("$TOOL" status "$VMID" 2>/dev/null)"
	echo "PW: état avant : ${before#status: }"
	echo "PW: retour au snapshot ${SNAP} (l'invité est arrêté pendant l'opération)"
	log "${VERB} ${VMID} ${SNAP}"
	if ! "$TOOL" rollback "$VMID" "$SNAP" </dev/null; then
		echo "PW-ERREUR: ${TOOL} rollback a échoué"
		exit 45
	fi
	echo "PW: retour au snapshot ${SNAP} terminé"
	if [[ "$before" == "status: running" && "$("$TOOL" status "$VMID" 2>/dev/null)" != "status: running" ]]; then
		echo "PW: redémarrage de l'invité (il tournait avant)"
		if ! "$TOOL" start "$VMID" </dev/null; then
			echo "PW-ERREUR: l'invité n'a pas redémarré : démarrez-le à la main"
			exit 46
		fi
	fi
	after="$("$TOOL" status "$VMID" 2>/dev/null)"
	echo "PW: état après : ${after#status: }"
	snap_info
}

run_restart_services() {
	log "${VERB} ${VMID}"
	g_stream 900 <<<"${RESTARTSCAN}
${RESTARTSVC}"
}

run_reboot() {
	local st i
	log "${VERB} ${VMID}"
	echo "PW: redémarrage de l'invité ${VMID} (${TOOL} reboot)"
	if ! timeout 300 "$TOOL" reboot "$VMID" --timeout 120 </dev/null; then
		echo "PW-ERREUR: ${TOOL} reboot a échoué"
		exit 52
	fi
	for ((i = 0; i < 60; i++)); do
		st="$("$TOOL" status "$VMID" 2>/dev/null)"
		[[ "$st" == "status: running" ]] && break
		sleep "$RES_POLL"
	done
	if [[ "$GT" == vm && "$st" == "status: running" ]]; then
		for ((i = 0; i < 90; i++)); do
			if timeout 20 qm agent "$VMID" ping </dev/null >/dev/null 2>&1; then
				echo "PW: agent invité de nouveau joignable"
				break
			fi
			sleep "$RES_POLL"
		done
	fi
	echo "PW: état après : ${st#status: }"
	[[ "$st" == "status: running" ]] || exit 52
}

run_docker_compose() {
	log "${VERB} ${VMID} ${ARGS[2]} simulation=${ARGS[3]}"
	g_stream "$TIMEOUT_UPDATE" "${ARGS[2]}" "${ARGS[3]}" <<<"$COMPOSEUP"
}

# Verbes disponibles pour les VM (pas d'appli community-scripts dans une VM).
if [[ "$GT" == vm && ! "$BASE" =~ ^(detect|apt|snapshot|snapdel|rollback|restart-services|reboot|docker-compose)$ ]]; then
	refuse "verbe indisponible pour une VM : ${VERB}"
fi

case "$BASE" in
ping)
	[[ ${#ARGS[@]} -eq 1 ]] || refuse "ping ne prend pas d'argument"
	echo "pw.wrapper_version=${WRAPPER_VERSION}"
	echo "pw.node=${NODE}"
	echo "pw.pve=$(pveversion 2>/dev/null | head -n 1)"
	;;
detect)
	[[ ${#ARGS[@]} -eq 3 ]] || refuse "usage : ${VERB} <vmid> <0|1>"
	[[ "${ARGS[2]}" =~ ^[01]$ ]] || refuse "rafraîchissement attendu : 0 ou 1"
	check_guest "${ARGS[1]}"
	log "${VERB} ${VMID} refresh=${ARGS[2]}"
	g_sh "$TIMEOUT_DETECT" "${ARGS[2]}" <<<"${SECSRC}
${RESTARTSCAN}
${DETECT}"
	rc=$?
	snap_info
	exit "$rc"
	;;
versions)
	[[ ${#ARGS[@]} -ge 3 && ${#ARGS[@]} -le 12 ]] || refuse "usage : lxc-versions <vmid> <app> (1 à 10 noms)"
	for n in "${ARGS[@]:2}"; do
		[[ "$n" =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]] || refuse "nom d'appli invalide : $n"
	done
	check_guest "${ARGS[1]}"
	g_sh 60 "${ARGS[@]:2}" <<<"$VERSIONS"
	exit $?
	;;
apt)
	[[ ${#ARGS[@]} -eq 4 ]] || refuse "usage : ${VERB} <vmid> <security|full|dist|omv> <0|1>"
	[[ "${ARGS[2]}" =~ ^(security|full|dist|omv)$ ]] || refuse "mode attendu : security, full, dist ou omv"
	[[ "${ARGS[3]}" =~ ^[01]$ ]] || refuse "simulation attendue : 0 ou 1"
	check_guest "${ARGS[1]}"
	if [[ "${ARGS[3]}" == 1 ]]; then
		# Simulation : lecture seule et courte, exécutée directement.
		run_apt
		exit $?
	fi
	run_detached apt run_apt
	;;
cs-update)
	[[ ${#ARGS[@]} -eq 5 ]] || refuse "usage : lxc-cs-update <vmid> <réponses> <cpu> <ram_mo>"
	[[ "${ARGS[2]}" =~ ^(-|[yn_](\.[yn_]){0,9})$ ]] || refuse "réponses attendues : - ou y/n/_ séparés par des points"
	[[ "${ARGS[3]}" =~ ^[0-9]{1,2}$ && "${ARGS[3]}" -le 64 ]] || refuse "cpu attendu : 0 à 64"
	[[ "${ARGS[4]}" =~ ^[0-9]{1,6}$ && "${ARGS[4]}" -le 262144 ]] || refuse "ram attendue : 0 à 262144 Mo"
	check_guest "${ARGS[1]}"
	run_detached cs-update run_cs_update
	;;
snapshot)
	[[ ${#ARGS[@]} -eq 7 ]] || refuse "usage : ${VERB} <vmid> <nom> <garder> <seuil_pct> <0|1> <description>"
	[[ "${ARGS[2]}" =~ $PW_SNAP_RE ]] || refuse "nom de snapshot PatchWarden attendu (pw-AAAAMMJJ-HHMM-action) : ${ARGS[2]}"
	[[ "${ARGS[3]}" =~ ^[1-9]$ ]] || refuse "nombre de snapshots à garder : 1 à 9"
	[[ "${ARGS[4]}" =~ ^[1-9][0-9]?$ ]] || refuse "seuil de remplissage : 1 à 99 %"
	[[ "${ARGS[5]}" =~ ^[01]$ ]] || refuse "vérification seule attendue : 0 ou 1"
	[[ "${ARGS[6]}" =~ ^(-|[A-Za-z0-9_-]{1,440})$ ]] || refuse "description : base64url ou - attendu"
	SNAP="${ARGS[2]}" KEEP="${ARGS[3]}" MAXPCT="${ARGS[4]}" DESC64="${ARGS[6]}"
	check_guest "${ARGS[1]}"
	if [[ "${ARGS[5]}" == 1 ]]; then
		snap_check
		exit $?
	fi
	run_detached snapshot run_snapshot
	;;
snapdel)
	[[ ${#ARGS[@]} -eq 3 ]] || refuse "usage : ${VERB} <vmid> <nom>"
	[[ "${ARGS[2]}" =~ $PW_SNAP_RE ]] || refuse "seuls les snapshots PatchWarden (pw-…) peuvent être supprimés : ${ARGS[2]}"
	SNAP="${ARGS[2]}"
	check_guest_exists "${ARGS[1]}"
	run_detached snapdel run_snapdel
	;;
rollback)
	[[ ${#ARGS[@]} -eq 3 ]] || refuse "usage : ${VERB} <vmid> <nom>"
	[[ "${ARGS[2]}" =~ $PW_SNAP_RE ]] || refuse "retour arrière limité aux snapshots PatchWarden (pw-…) : ${ARGS[2]}"
	SNAP="${ARGS[2]}"
	check_guest_exists "${ARGS[1]}"
	run_detached rollback run_rollback
	;;
restart-services)
	[[ ${#ARGS[@]} -eq 2 ]] || refuse "usage : ${VERB} <vmid>"
	check_guest "${ARGS[1]}"
	run_detached services run_restart_services
	;;
reboot)
	[[ ${#ARGS[@]} -eq 2 ]] || refuse "usage : ${VERB} <vmid>"
	check_guest "${ARGS[1]}"
	run_detached reboot run_reboot
	;;
docker-compose)
	[[ ${#ARGS[@]} -eq 4 ]] || refuse "usage : ${VERB} <vmid> <projet> <0|1>"
	[[ "${ARGS[2]}" =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] || refuse "nom de projet compose invalide : ${ARGS[2]}"
	[[ "${ARGS[3]}" =~ ^[01]$ ]] || refuse "simulation attendue : 0 ou 1"
	check_guest "${ARGS[1]}"
	if [[ "${ARGS[3]}" == 1 ]]; then
		run_docker_compose
		exit $?
	fi
	run_detached docker run_docker_compose
	;;
*)
	refuse "verbe inconnu : ${VERB}"
	;;
esac
